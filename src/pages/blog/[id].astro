---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import BlogPostingJsonLd from "../../components/JsonLd/BlogPostingJsonLd.astro";
import Prose from "../../components/Prose/Prose.astro";
import { publishedPostFilter } from "../../content.config";

export async function getStaticPaths() {
  const posts = await getCollection("blog", publishedPostFilter);
  return posts.map((post, idx) => ({
    params: { id: post.id },
    props: { posts, post, idx },
  }));
}

const { posts, post, idx } = Astro.props;

const { Content } = await render(post);
---

<Layout
  title={post.data.title}
  description={post.data.description}
  image={post.data.coverImage}
  type="article"
  publishedDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
>
  <BlogPostingJsonLd slot="head" post={post} />
  <a class="back" href="/blog">
    <span>&lt;-</span> All posts
  </a>
  <div
    class="blog-post"
    transition:name="blog-post"
    transition:animate="initial"
  >
    {
      post.data.coverImage && (
        <Image
          class="cover"
          src={post.data.coverImage}
          alt=""
          transition:name={`post-cover-${post.id}`}
        />
      )
    }
    <h1>{post.data.title}</h1>
    <Prose>
      <Content />
    </Prose>
    {
      posts.length > 1 && (
        <div class="bottom-nav-controls">
          {idx > 0 && (
            <a class="back" href={`/blog/${posts[idx - 1].id}`}>
              <span>&lt;-</span> previous
            </a>
          )}
          {idx < posts.length - 1 && (
            <a class="next" href={`/blog/${posts[idx + 1].id}`}>
              next <span>-&gt;</span>
            </a>
          )}
        </div>
      )
    }
  </div>
</Layout>

<style>
  .blog-post {
    display: grid;
    gap: 2rem;
  }
  .cover {
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .bottom-nav-controls {
    display: flex;
    width: 100%;
  }

  .bottom-nav-controls .next {
    margin-left: auto;
  }

  .back,
  .next {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    transition: color 0.2s var(--ease);
  }

  .back:hover,
  .next:hover {
    color: var(--color-ink);
  }

  .back span,
  .next span {
    display: inline-block;
    transition: transform 0.2s var(--ease);
  }

  .back:hover span {
    transform: translateX(-3px);
  }
  .next:hover span {
    transform: translateX(3px);
  }
</style>
