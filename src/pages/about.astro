---
import FadeInImage from "../components/FadeInImage/FadeInImage.astro";
import HeroSection from "../components/HeroSection/HeroSection.astro";
import NameTag from "../components/NameTag.tsx/NameTag.astro";
import Layout from "../layouts/Layout.astro";
import beachImage from "../assets/beach.jpg";
import { Content as AboutContent } from "../content/about/about.md";
import Prose from "../components/Prose/Prose.astro";
---

<Layout
  title="About"
  description="A little about Matthew Ritter — software engineer, builder, and dad."
>
  <div class="wrapper">
    <div class="about-image-section">
      <FadeInImage
        src={beachImage}
        alt=""
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="name-tag">
      <NameTag name="Matthew" />
    </div>
  </div>
  <section>
    <Prose>
      <AboutContent />
    </Prose>
  </section>
</Layout>

<style>
  .wrapper {
    display: flex;
    justify-content: center;
    position: relative;
    margin-bottom: 5rem;
  }

  .about-image-section {
    position: relative;
    display: flex;
    justify-self: center;
    border: 10px solid var(--secondary-color);
    border-radius: 20px;
    height: 400px;
    width: 100%;
    max-width: 500px;
    overflow: hidden;
  }

  .name-tag {
    position: absolute;
    inset: 0;
    top: unset;
    bottom: 0;
    left: 50%;
    transform: translateY(50%) translateX(-50%);
    width: min-content;
    height: min-content;
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
