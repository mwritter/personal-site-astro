---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import ResumeSection from "../components/ResumeSection/ResumeSection.astro";
import ResumeSkills from "../components/ResumeSkills/ResumeSkills.astro";

const sections = (await getCollection("resume")).sort((a, b) => {
  if (a.data.startDate && b.data.startDate) {
    return b.data.startDate - a.data.startDate;
  }
  return 1;
});
---

<Layout
  title="Resume"
  description="Matthew Ritter's resume — over a decade of software engineering experience."
>
  <div id="resume">
    <div>
      <h1>Matthew Ritter</h1>
      <p class="subtext">Senior Software Engineer</p>
      <p class="subtext">matthew.william.ritter@gmail.com</p>
    </div>
    <div>
      <p class="subtext">
        TypeScript · React · Next.js · Node.js · Go · APIs · System Design ·
        Developer Tooling
      </p>
    </div>
    <section>
      <h2>Summary</h2>
      <p class="subtext">
        Senior Software Engineer with 10+ years of experience designing and
        building production software across the stack. Deep expertise in
        TypeScript, React, and modern web architecture, with a track record of
        leading complex frontend and full-stack initiatives from technical
        investigation through implementation and delivery.
      </p>
      <p class="subtext">
        Experienced in modernizing legacy applications, designing reusable
        platforms and component systems, building developer tooling, and
        integrating AI capabilities into developer workflows. Comfortable owning
        ambiguous technical problems, making architectural decisions,
        collaborating directly with product and design teams, and mentoring
        engineers.
      </p>
    </section>

    <section class="experience">
      <h2>Experience</h2>
      <div class="resume-sections">
        {sections.map((section) => <ResumeSection section={section} />)}
      </div>
    </section>
    <section>
      <h2>Education</h2>
      <p class="subtext">
        Valdosta State University, Valdosta, Ga – BS in Computer Information
        Systems
      </p>
    </section>
    <section>
      <h2>Technical Skills</h2>
      <ResumeSkills
        title="Languages"
        skills={["TypeScript", "JavaScript", "Go", "Rust", "Python", "PHP"]}
      />
      <ResumeSkills
        title="Frontend & Product Engineering"
        skills={[
          "React",
          "Next.js",
          "Astro",
          "Vite",
          "Storybook",
          "HTML",
          "CSS",
          "SCSS",
          "Tailwind CSS",
        ]}
      />
      <ResumeSkills
        title="Backend & APIs"
        skills={[
          "Node.js",
          "Express",
          "GraphQL",
          "REST APIs",
          "API Design",
          "SQLite",
        ]}
      />
      <ResumeSkills
        title="Engineering & Infrastructure"
        skills={[
          "GitHub Actions",
          "CI/CD",
          "Automated Testing",
          "Playwright",
          "Jest",
          "React Testing Library",
          "System Design",
          "Component Libraries",
          "Developer Tooling",
        ]}
      />
      <ResumeSkills
        title="AI & Developer Platforms"
        skills={[
          "Model Context Protocol (MCP)",
          "AI Agent Integrations",
          "CLI Development",
          "Developer Experience",
        ]}
      />
    </section>
  </div>
</Layout>

<style>
  #resume {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 800px;
    margin: 0 auto;
  }
  section {
    display: grid;
    gap: 0.5rem;
    break-inside: avoid;
  }
  section.experience {
    break-inside: auto;
  }
  .subtext {
    font-size: smaller;
  }

  h2 {
    font-size: 20px;
    font-weight: 800;
    break-after: avoid;
  }

  /* Chrome fragments flex and grid containers unreliably across printed pages:
     headings get painted twice at the break and whole blocks can disappear.
     Plain block flow with margins paginates correctly. */
  @media print {
    #resume {
      display: block;
    }
    #resume > div,
    #resume > section {
      margin-bottom: 1rem;
    }
    section {
      display: block;
    }
    section > * + * {
      margin-top: 0.4rem;
    }
    p {
      orphans: 3;
      widows: 3;
    }
  }
</style>
