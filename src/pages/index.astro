---
import HeroSection from "../components/HeroSection/HeroSection.astro";
import BorderImage from "../components/BorderImage/BorderImage.astro";
import Layout from "../layouts/Layout.astro";
import RecentBlogPost from "../components/RecentBlogPosts/RecentBlogPosts.astro";
import JsonLd from "../components/JsonLd/JsonLd.astro";
import meImage from "../assets/me.png";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Matthew Ritter",
  url: Astro.site?.href,
  jobTitle: "Software Engineer",
  sameAs: [
    "https://www.github.com/mwritter",
    "https://www.linkedin.com/in/mwritter",
  ],
};
---

<Layout>
  <JsonLd slot="head" data={jsonLd} />
  <div class="container">
    <HeroSection>
      <div class="intro">
        <p class="eyebrow">Software Engineer</p>
        <h1>Matthew Ritter</h1>
        <p class="lead">
          Hey I'm Matthew, I'm a software engineer with 10+ years of experience
          building production software. I work primarily with TypeScript, React,
          Node.js, and modern web architecture, while increasingly exploring
          backend systems, Go, developer tooling, and AI-assisted development.
          Welcome to my little corner of the internet.
        </p>
        <p class="stack">
          TypeScript · React · Node.js · Go · Developer tooling
        </p>
        <div class="actions">
          <a class="action action-primary" href="/blog">
            Read my writing <span aria-hidden="true">-&gt;</span>
          </a>
          <a class="action" href="/resume">View resume</a>
        </div>
      </div>
      <BorderImage src={meImage} />
    </HeroSection>
    <div id="recent-blog-section" transition:animate="initial">
      <RecentBlogPost />
    </div>
  </div>
</Layout>

<style>
  .container {
    display: grid;
    gap: var(--space-section);
  }

  .intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .eyebrow {
    font-size: var(--text-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  h1 {
    margin-top: calc(var(--space-2) * -1);
  }

  .lead {
    max-width: var(--measure);
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  .stack {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
    font-size: var(--text-sm);
  }

  .action {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition:
      background-color 0.2s var(--ease),
      border-color 0.2s var(--ease),
      transform 0.2s var(--ease);
  }

  .action:hover {
    background-color: var(--color-surface-hover);
    border-color: var(--color-border-strong);
    transform: translateY(-2px);
  }

  .action-primary {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-on-accent);
  }

  .action-primary:hover {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .action-primary span {
    transition: transform 0.2s var(--ease);
  }

  .action-primary:hover span {
    transform: translateX(3px);
  }
</style>
