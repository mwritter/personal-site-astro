---
import Invader from "../../assets/invader.svg";
import ThemeToggle from "../ThemeToggle/ThemeToggle.astro";
import PageNavIndicator from "./PageNavIndicator.astro";

const LINKS = [
  { href: "/about", label: "About" },
  { href: "/blog", label: "Writing" },
];

const normalize = (path: string) => path.replace(/\/$/, "") || "/";

const current = normalize(Astro.url.pathname);
const isActive = (href: string) =>
  current === href || current.startsWith(`${href}/`);
---

<nav class="page-nav">
  <div class="nav-inner">
    <a
      class="brand"
      href="/"
      aria-label="Home"
      aria-current={current === "/" ? "page" : undefined}
    >
      <Invader width={30} height={22} aria-hidden="true" />
    </a>

    <div class="nav-links">
      {
        LINKS.map(({ href, label }) => (
          <a
            href={href}
            data-active={isActive(href)}
            aria-current={isActive(href) ? "page" : undefined}
          >
            <span class="label">{label}</span>
            {isActive(href) && <PageNavIndicator />}
          </a>
        ))
      }
    </div>
    <ThemeToggle />
  </div>
</nav>

<style>
  .page-nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background-color: color-mix(in srgb, var(--color-bg) 82%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);

    @media print {
      display: none !important;
    }
  }

  .nav-inner {
    max-width: 1000px;
    margin: 0 auto;
    padding: var(--space-3) var(--space-8);
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .brand {
    display: grid;
    place-content: center;
    height: 40px;
    width: 40px;
    border-radius: var(--radius-md);
    transition:
      background-color 0.2s var(--ease),
      transform 0.2s var(--ease);
  }

  .brand:hover,
  .brand[aria-current="page"] {
    background-color: var(--color-surface-hover);
    transform: translateY(-1px);
  }

  .brand svg {
    display: block;
    transition: transform 0.25s var(--ease);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    margin-right: auto;
    font-size: var(--text-sm);
  }

  .nav-links a {
    position: relative;
    padding: var(--space-1) 0;
    color: var(--color-ink-muted);
    transition: color 0.2s var(--ease);
  }

  .nav-links a:hover {
    color: var(--color-ink);
  }

  .nav-links a[data-active="true"] {
    color: var(--color-ink);
  }

  .label {
    position: relative;
    z-index: 1;
  }
</style>
