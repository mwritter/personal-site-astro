---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-inner">
    <nav aria-label="Footer">
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/blog">Writing</a></li>
        <li><a href="/resume">Resume</a></li>
      </ul>
    </nav>

    <div class="meta">
      <div class="social">
        <a
          href="https://www.github.com/mwritter"
          target="_blank"
          rel="noopener"
          referrerpolicy="no-referrer"
          aria-label="GitHub"
        >
          <img src="/github.svg" height="20" width="20" alt="" />
        </a>
        <a
          href="https://www.linkedin.com/in/mwritter"
          target="_blank"
          rel="noopener"
          referrerpolicy="no-referrer"
          aria-label="LinkedIn"
        >
          <img src="/linkedIn.svg" height="20" width="20" alt="" />
        </a>
        <a href="/rss.xml" aria-label="RSS feed">RSS</a>
      </div>
      <p class="colophon">&copy; {year} Matthew Ritter</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    flex-shrink: 0;
    background-color: var(--color-panel);
    color: var(--color-panel-ink);
    border-top: 1px solid var(--color-border);

    @media print {
      display: none !important;
    }
  }

  .footer-inner {
    max-width: 1000px;
    margin: 0 auto;
    padding: var(--space-8);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-8);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    font-size: var(--text-sm);
  }

  a {
    opacity: 0.75;
    transition:
      opacity 0.2s var(--ease),
      transform 0.2s var(--ease);
  }

  a:hover {
    opacity: 1;
  }

  .meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .social {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    font-size: var(--text-sm);
  }

  .social a:hover {
    transform: translateY(-2px);
  }

  .social img {
    display: block;
  }

  .colophon {
    font-size: var(--text-xs);
    opacity: 0.6;
  }

  @media (min-width: 640px) {
    .meta {
      align-items: flex-end;
    }
  }
</style>
