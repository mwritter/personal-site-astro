---
import { Image } from "astro:assets";
import { formatDate } from "../../utils/formatData";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, pubDate, coverImage } = post.data;
---

<div class="blog-summary" transition:animate="initial">
  <a href={`/blog/${post.id}`}>
    <div class="content">
      {
        coverImage && (
          <Image
            class="cover"
            src={coverImage}
            alt=""
            transition:name={`post-cover-${post.id}`}
          />
        )
      }
      <div class="info">
        <h3>{title}</h3>
        <div class="description">
          <p>{description}</p>
          {
            pubDate && (
              <time datetime={pubDate.toISOString()}>
                {formatDate(pubDate)}
              </time>
            )
          }
        </div>
      </div>
    </div>
  </a>
</div>

<style>
  .blog-summary {
    width: 100%;
  }
  .content {
    padding: 1rem 0;
    display: grid;
    gap: 1rem;
    justify-content: center;
    align-items: center;
    flex-direction: column;

    @media (min-width: 600px) {
      grid-template-columns: 1fr 1fr;
    }
  }
  .info {
    display: flex;
    flex-direction: column;
    gap: 5px;
    font-size: small;
  }
  .cover {
    width: 100%;
    height: auto;
    border-radius: 8px;
  }
  time {
    font-size: smaller;
    justify-self: end;
    opacity: 0.5;
  }
</style>
