---
import { getCollection } from "astro:content";
import BlogSummary from "../BlogSummary/BlogSummary.astro";
import { publishedPostFilter } from "../../content.config";

const posts = (await getCollection("blog", publishedPostFilter))
  .sort((a, b) => b.data.pubDate!.valueOf() - a.data.pubDate!.valueOf())
  .slice(0, 3);
---

<section transition:animate="initial">
  {
    posts.length > 0 ? (
      <>
        <div class="section-head">
          <h2>Recent Writings</h2>
          <a class="all" href="/blog">
            All posts <span aria-hidden="true">-&gt;</span>
          </a>
        </div>
        <ul>
          {posts.map((post) => (
            <li>
              <BlogSummary post={post} />
            </li>
          ))}
        </ul>
      </>
    ) : null
  }
</section>

<style>
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  h2 {
    font-size: var(--text-xl);
  }

  .all {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    transition: color 0.2s var(--ease);
  }

  .all:hover {
    color: var(--color-ink);
  }

  .all span {
    display: inline-block;
    transition: transform 0.2s var(--ease);
  }

  .all:hover span {
    transform: translateX(3px);
  }

  ul {
    display: grid;
    gap: var(--space-4);
  }
</style>
