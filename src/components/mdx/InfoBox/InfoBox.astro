---
interface Props {
  info: string[];
  size: "sm" | "md" | "lg";
}

const { info, size } = Astro.props;
---

<pre
  class="info-box"
  data-size={size}>
  {info?.map((i) => <p>{i}</p>)}
  <slot />
</pre>

<style>
  .info-box {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border: 2px solid var(--foreground-color-light);
    padding: 0.5rem 1rem;
    width: 100%;
    text-align: center;
    margin: 0 auto;
    color: var(--foreground-color-light);

    &[data-size="sm"] {
      max-width: 500px;
    }

    &[data-size="md"] {
      width: 50%;
    }
  }
</style>
