---
import FadeInImage from "../FadeInImage/FadeInImage.astro";

const { src } = Astro.props;
---

<div class="border-image">
  <FadeInImage class="img" src={src} alt="" loading="eager" fetchpriority="high" />
</div>

<style>
  .border-image {
    display: flex;
    justify-content: center;
    justify-self: center;
    width: 100%;
    max-width: 375px;
    height: 375px;
    border-radius: var(--radius-xl);
    background-color: var(--color-panel);
    padding: var(--space-4);
    box-shadow: var(--shadow-lg);
  }

  .border-image img {
    height: 100%;
    width: 100%;
    background-color: var(--color-bg);
    border-radius: 12px;
    overflow: hidden;
    object-fit: cover;
  }
</style>
