---
import FadeInImage from "../FadeInImage/FadeInImage.astro";

const { src } = Astro.props;
---

<div class="border-image">
  <FadeInImage class="img" src={src} alt="" loading="eager" fetchpriority="high" />
</div>

<style>
  .border-image {
    display: flex;
    justify-content: center;
    justify-self: center;
    width: 100%;
    max-width: 375px;
    height: 375px;
    border-radius: 20px;
    background-color: var(--secondary-color);
    padding: 1rem;
  }

  .border-image img {
    height: auto;
    width: 100%;
    background-color: var(--primary-color);
    border-radius: 20px;
    overflow: hidden;
    object-fit: cover;
  }
</style>
